# opencode-rc configuration template.
# Copy to `.env` (git-ignored) and fill in. Never commit `.env`.

# ---------------------------------------------------------------------------
# opencode connection
# ---------------------------------------------------------------------------
# Base URL of your opencode server. If you run `opencode web` locally this is
# http://127.0.0.1:4096. Never bind opencode to the public internet.
RC_OPENCODE_URL=http://127.0.0.1:4096
# Optional HTTP basic auth, only if you set OPENCODE_SERVER_USERNAME/PASSWORD.
RC_OPENCODE_USERNAME=
RC_OPENCODE_PASSWORD=

# Default project directory passed as ?directory= to opencode endpoints.
RC_PROJECT_DIR=

# ---------------------------------------------------------------------------
# Safety — these fail closed. Read SECURITY.md before changing them.
# ---------------------------------------------------------------------------
# Master kill switch. When true every inbound message is dropped before the
# allowlist is even consulted.
RC_DISABLED=false

# Local, outbound-only, no telemetry. Defaults to 127.0.0.1
RC_HOST=127.0.0.1
RC_PORT=8787

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# silent < error < warn < info < debug < trace
RC_LOG_LEVEL=info
# Comma-separated namespaces, e.g. RC_DEBUG_FILTER=opencode,permissions
RC_DEBUG_FILTER=
# RC_LOG_ROTATE_MAX_BYTES=10485760
# RC_LOG_ROTATE_MAX_FILES=10
# RC_LOG_RETENTION_DAYS=7
# RC_AUDIT_RETENTION_DAYS=90
# Store audit actor ids raw instead of sha256(salt + id). Off by default.
RC_LOG_ACTOR=hash

# ---------------------------------------------------------------------------
# Adapters — enable the ones you use.
# ---------------------------------------------------------------------------

# Telegram (https://my.telegram.org/bots)
RC_TELEGRAM_ENABLED=false
RC_TELEGRAM_BOT_TOKEN=

# Discord (developer portal -> Bot -> Token). Needs MESSAGE_CONTENT intent.
RC_DISCORD_ENABLED=false
RC_DISCORD_BOT_TOKEN=
# Public key from the app's General Information page. REQUIRED: the adapter
# verifies the Ed25519 signature on every interaction before answering a
# permission, and refuses to start without a valid key.
RC_DISCORD_PUBLIC_KEY=
# Interactions endpoint binding. Loopback by default; Discord must reach it, so
# expose it behind TLS (e.g. Tailscale Funnel) and set the URL in the portal.
RC_DISCORD_INTERACTIONS_HOST=127.0.0.1
RC_DISCORD_INTERACTIONS_PORT=8789

# Slack (Socket Mode — no public URL required).
RC_SLACK_ENABLED=false
RC_SLACK_BOT_TOKEN=
RC_SLACK_APP_TOKEN=

# Generic webhooks.
RC_WEBHOOK_ENABLED=false
RC_WEBHOOK_PORT=8788
RC_WEBHOOK_TOKEN=

# REST + SSE API (Tailscale only). Password required.
RC_API_ENABLED=false
RC_API_PASSWORD=

# MCP server (stdio) — exposes opencode-rc tools to Claude Desktop etc.
RC_MCP_ENABLED=false

# ---------------------------------------------------------------------------
# Cost control
# ---------------------------------------------------------------------------
RC_MAX_TURNS_PER_PROMPT=50
RC_MAX_NOTIFICATIONS_PER_RUN=20
RC_MAX_CONCURRENT_SESSIONS=4

# ---------------------------------------------------------------------------
# opencode safety check (§2.4). opencode-rc refuses to start if the
# configured `permission` mode is not `ask`.
# ---------------------------------------------------------------------------
RC_REQUIRE_PERMISSION_ASK=true